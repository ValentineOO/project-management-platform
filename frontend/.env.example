# ── API ───────────────────────────────────────────────────────────────────────
# Public: used by the browser to call the API directly
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-side: used by Next.js server to call the API (inside Docker, use the service name)
API_URL=http://backend:8000

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="Project Management Platform"
NODE_ENV=development
